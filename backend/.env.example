# CareerMatch AI - Backend Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Adzuna API (Get free credentials from https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# The Muse API (https://www.themuse.com/developers/api/v2)
THE_MUSE_API_KEY=

# Remote OK is a public remote-work source and does not require an API key.

# Job Aggregation & Validation
URL_VALIDATION_TIMEOUT=3.5
DEFAULT_EXPIRY_DAYS=60
MAX_JOBS_PER_SOURCE=25
